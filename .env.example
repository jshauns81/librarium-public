# Local synthetic experiment only; keep real values in an ignored .env file.
LIBRARIUM_DB_PASSWORD=
# Optional separated web/worker login for compose.registry-workspace.yaml.
# Provision librarium_runtime after owner migrations; keep its password independent.
# Compose interpolation only: do not emit this key into a Django process environment.
LIBRARIUM_RUNTIME_DB_PASSWORD=
LIBRARIUM_SECRET_KEY=
# Optional selected development directory containing published BLC snapshots.
LIBRARIUM_CATALOGUE_DIR=
# Optional worker-polled BLC API base, e.g. https://catalogue.example.com; empty disables.
LIBRARIUM_CATALOGUE_STATUS_URL=
# Optional controls link, e.g. https://catalogue.example.com/status; empty hides it.
LIBRARIUM_CATALOGUE_STATUS_PAGE_URL=
# Optional private native reference evidence/generations/receipts; no automatic fetches.
LIBRARIUM_REFERENCE_STATE_DIR=
# Optional read-only local originals, stored as <directory>/<sha256[:2]>/<sha256>.
LIBRARIUM_CATALOGUE_COVER_DIR=
# Optional read-only derivative blobs for the dashboard examples; same digest layout.
LIBRARIUM_CATALOGUE_UPSCALED_COVER_DIR=
# Worker only; disabled by default. Covers default under the catalogue directory
# when these two overrides are omitted or empty. Never place covers under artifacts.
LIBRARIUM_CATALOGUE_SYNC_ENABLED=false
# Set to 1 only when the selected catalogue contains fictional test data.
LIBRARIUM_CATALOGUE_FIXTURE=
# Public-mode settings are separate from the loopback-only local experiment.
LIBRARIUM_PUBLIC_ORIGIN=
LIBRARIUM_TRUST_PROXY=
# Dockhand: choose an absolute persistent host directory; see docs/dockhand.md.
LIBRARIUM_DATA_ROOT=
LIBRARIUM_EDGE_NETWORK=librarium-edge
# Optional trusted LF server origin for saved library matches; no credentials/path.
LIBRARIUM_LIBRARY_URL=
# Optional native read-only Calibre library root; preferred over saved LF browsing.
# Containers opt in using compose.library.yaml; mount originals read-only.
LIBRARIUM_DIRECT_LIBRARY_ROOT=
LIBRARIUM_LIBRARY_HOST_PATH=
# Optional app-owned private storage for preserved EPUB uploads and reports.
# Bare development only: absolute existing directory, owned by this runtime, mode 0700.
# Containers: opt in through compose.files.yaml after preparing the persistent mount.
LIBRARIUM_ARTIFACT_DIR=
# Optional independently curated complete-content references; both values are required together.
# Bare development: absolute registry file outside the checkout and writable application/library state.
LIBRARIUM_CONTENT_TRUST_REGISTRY=
LIBRARIUM_CONTENT_TRUST_REGISTRY_SHA256=
# Containers: compose.content-trust.yaml mounts this separate directory read-only.
# It must contain registry.json and digest-named manifests/, evidence/ and artifacts/ leaves.
LIBRARIUM_CONTENT_TRUST_HOST_PATH=
# Bare development: absolute libarchive 3.8.10 shared-library path from scripts/build_libarchive.py.
# The container fixes this path inside its image.
LIBARCHIVE=

# Agent-only configuration, never passed to application containers.
# Outside-checkout private context directory; contains handoff.md, no credentials.
LIBRARIUM_AGENT_CONTEXT=
# Optional outside-checkout file with private terms for the publication gate.
LIBRARIUM_PRIVATE_TERMS_FILE=
